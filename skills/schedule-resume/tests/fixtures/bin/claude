#!/bin/sh
printf '%s\n' "$PWD" >"$RESUME_TEST_CWD_CAPTURE"
jq -n '$ARGS.positional' --args -- "$@" >"$RESUME_TEST_HARNESS_LOG"
cat >"$RESUME_TEST_PROMPT_CAPTURE"
if [ -n "${RESUME_TEST_HARNESS_BARRIER:-}" ]; then
  touch "$RESUME_TEST_HARNESS_BARRIER/launched.$$" || exit 1
  schedule_resume_harness_wait_count=0
  while [ ! -e "$RESUME_TEST_HARNESS_BARRIER/release" ]; do
    schedule_resume_harness_wait_count=$((schedule_resume_harness_wait_count + 1))
    [ "$schedule_resume_harness_wait_count" -lt 500 ] || exit 1
    /bin/sleep 0.01
  done
fi
printf '%s\n' "${RESUME_TEST_OUTPUT:-}"
exit "${RESUME_TEST_EXIT_CODE:-0}"
