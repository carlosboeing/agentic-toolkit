.claude/
# Grok /briefing save dest. The skill leaves briefing-log unignored by
# default; this repo already ignores .claude/ and would otherwise pick
# up the first Grok /briefing save as an untracked tree. Do not ignore
# all of .grok/ — a later project-scoped .grok/config.toml is a
# different artifact.
.grok/briefing-log/
.worktrees/
.DS_Store

# Playwright MCP scratch output (snapshots, screenshots) written into the cwd
.playwright-mcp/

# Nested canonical superpowers clone (its own git repo; managed via git pull)
plugins/superpowers/

# Python bytecode (e.g. from compile-checking doc assets)
__pycache__/
*.pyc

# Plain English telemetry reports (contain local paths and excerpts)
tools/plain-english/eval/telemetry/
